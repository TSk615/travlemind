# Copy these keys into E:\travel\.env for direct API/worker runs if you need overrides.
# For Docker Compose, use this file directly with:
# docker compose --env-file infra/.env.example -f infra/docker-compose.yml up --build

# Host ports
WEB_PORT=3000
API_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432

# Managed-service placeholders
POSTGRES_DB=travelmind
POSTGRES_USER=travelmind
POSTGRES_PASSWORD=travelmind

# App defaults for direct local runs
TRAVELMIND_DATABASE_URL=sqlite:///./storage/travelmind.db
TRAVELMIND_EXPORT_ROOT=./storage/exports
TRAVELMIND_JWT_SECRET=travelmind-dev-secret
TRAVELMIND_QUEUE_MODE=inline
TRAVELMIND_REDIS_URL=redis://127.0.0.1:6379/0
TRAVELMIND_AGENT_PROVIDER=stub
TRAVELMIND_PUBLIC_API_URL=http://localhost:8000
TRAVELMIND_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:3000","http://localhost:3000"]

# Web build-time environment
VITE_API_BASE_URL=http://localhost:8000

# Set this to helloagents only for explicit PoC validation after the dependency is available.
# TRAVELMIND_AGENT_PROVIDER=helloagents

