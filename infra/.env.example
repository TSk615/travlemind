# Copy these keys into E:\travel\.env for direct API/worker runs if you need overrides.
# For Docker Compose, use this file directly with:
# docker compose --env-file infra/.env.example -f infra/docker-compose.yml up --build

# Host ports
WEB_PORT=3000
API_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432
XHS_CRAWLER_PORT=8090
GROKSEARCH_BRIDGE_PORT=8085

# Managed-service placeholders
POSTGRES_DB=travelmind
POSTGRES_USER=travelmind
POSTGRES_PASSWORD=travelmind

# App defaults for direct local runs
TRAVELMIND_ENVIRONMENT=development
TRAVELMIND_DATABASE_URL=postgresql+psycopg://travelmind:travelmind@localhost:5432/travelmind
TRAVELMIND_COMPOSE_DATABASE_URL=postgresql+psycopg://travelmind:travelmind@postgres:5432/travelmind
TRAVELMIND_COMPOSE_WORKFLOW_CHECKPOINT_URL=postgresql://travelmind:travelmind@postgres:5432/travelmind
TRAVELMIND_EXPORT_ROOT=./storage/exports
TRAVELMIND_JWT_SECRET=travelmind-dev-secret-change-me-32-bytes-minimum
TRAVELMIND_CREDENTIAL_ENCRYPTION_KEY=travelmind-dev-credential-key-change-me-32-bytes
TRAVELMIND_COOKIE_SECURE=false
TRAVELMIND_COOKIE_SAMESITE=lax
TRAVELMIND_CSRF_ENABLED=true
TRAVELMIND_CSRF_COOKIE_NAME=travelmind_csrf
TRAVELMIND_CSRF_HEADER_NAME=X-CSRF-Token
TRAVELMIND_RATE_LIMIT_ENABLED=true
TRAVELMIND_RATE_LIMIT_BACKEND=memory
TRAVELMIND_RATE_LIMIT_WINDOW_SECONDS=60
TRAVELMIND_RATE_LIMIT_DEFAULT_REQUESTS=240
TRAVELMIND_RATE_LIMIT_AUTH_REQUESTS=10
TRAVELMIND_RATE_LIMIT_EXPENSIVE_REQUESTS=30
TRAVELMIND_JOB_MAX_ATTEMPTS=3
TRAVELMIND_JOB_TIMEOUT_SECONDS=900
TRAVELMIND_JOB_RETRY_BASE_SECONDS=5
TRAVELMIND_JOB_HEARTBEAT_SECONDS=15
TRAVELMIND_JOB_STALE_AFTER_SECONDS=120
TRAVELMIND_JOB_RESULT_TTL_SECONDS=86400
TRAVELMIND_WORKER_MAX_JOBS=8
TRAVELMIND_QUEUE_MODE=inline
TRAVELMIND_REDIS_URL=redis://127.0.0.1:6379/0
TRAVELMIND_AGENT_PROVIDER=stub
TRAVELMIND_ADMIN_EMAILS=admin@example.com
TRAVELMIND_PUBLIC_API_URL=http://localhost:8000
TRAVELMIND_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:3000","http://localhost:3000"]
# Upstream URL policy for user-configured LLM/search/image endpoints:
# loopback keeps localhost dev gateways working; set to deny in production to block all private/local addresses.
TRAVELMIND_UPSTREAM_PRIVATE_URL_POLICY=loopback
TRAVELMIND_UPSTREAM_URL_ALLOWED_HOSTS=groksearch-bridge,host.docker.internal
TRAVELMIND_SEARCH_SERVICE_PROVIDER=groksearch
TRAVELMIND_SEARCH_SERVICE_TRANSPORT=mcp
TRAVELMIND_GROKSEARCH_BRIDGE_BASE_URL=http://groksearch-bridge:8085/mcp
TRAVELMIND_GROKSEARCH_BRIDGE_API_KEY=travelmind-groksearch-dev-key
TRAVELMIND_GROKSEARCH_BRIDGE_TIMEOUT_SECONDS=75

# Maps / POI provider
# stub is for local tests only. Use amap/gaode after applying for a Gaode Web Service API key.
TRAVELMIND_MAPS_PROVIDER=stub
TRAVELMIND_AMAP_API_KEY=
TRAVELMIND_AMAP_BASE_URL=https://restapi.amap.com
TRAVELMIND_AMAP_TIMEOUT_SECONDS=8

# Web build-time environment
VITE_API_BASE_URL=http://localhost:8000

# Use langgraph for the durable multi-role workflow; standard is the single-model fallback.
# TRAVELMIND_AGENT_PROVIDER=langgraph

# Search defaults already point to the bundled GrokSearch bridge.

# Xiaohongshu crawler integration (internal / research only)
TRAVELMIND_XHS_CRAWLER_ENABLED=false
TRAVELMIND_XHS_CRAWLER_BASE_URL=http://xhs-crawler:8090
TRAVELMIND_XHS_CRAWLER_API_KEY=
TRAVELMIND_XHS_CRAWLER_TIMEOUT_SECONDS=20
TRAVELMIND_XHS_CACHE_TTL_SECONDS=1800
TRAVELMIND_XHS_LIMIT_PER_QUERY=5
TRAVELMIND_XHS_MAX_RESULTS=10
TRAVELMIND_XHS_SESSION_SECRET=
TRAVELMIND_XHS_NODE_BINARY=node
TRAVELMIND_XHS_OPENCLI_BINARY=opencli
TRAVELMIND_XHS_OPENCLI_TIMEOUT_SECONDS=45

# Build-time package mirrors
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_EXTRA_INDEX_URL=
PIP_DEFAULT_TIMEOUT=120

# GrokSearch bridge build and runtime settings
GROKSEARCH_GIT_URL=https://github.com/GuDaStudio/GrokSearch
GROKSEARCH_REF=grok-with-tavily
TRAVELMIND_GROKSEARCH_COMMAND=grok-search
GUDA_BASE_URL=https://code.guda.studio
GUDA_API_KEY=
GROK_API_URL=
GROK_API_KEY=
GROK_MODEL=Web/grok-chat-fast
GROK_WIRE_API=chat_completions
# Optional fallback: use Grok itself as the direct LLM for weather/hotel/transport specialist roles
# when no saved POI role override is available. Saved POI model settings are reused first.
# If these are empty, the API falls back to GROK_API_URL/GROK_API_KEY/GROK_MODEL when all three are set.
TRAVELMIND_GROK_LLM_BASE_URL=
TRAVELMIND_GROK_LLM_API_KEY=
TRAVELMIND_GROK_LLM_MODEL=
TRAVELMIND_GROK_LLM_PROVIDER_PROTOCOL=newapi
TRAVELMIND_GROK_LLM_WIRE_API=chat_completions
TRAVELMIND_GROK_LLM_TIMEOUT_SECONDS=30
TAVILY_ENABLED=true
TAVILY_API_URL=
TAVILY_API_KEY=
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=
GROK_DEBUG=false
GROK_LOG_LEVEL=INFO
# Enable only when the local TUN proxy uses 198.18.0.0/15 for public-domain DNS.
TRAVELMIND_IMAGE_ALLOW_FAKE_IP=false

# Optional Exa search failover in the inprocess GrokSearch bridge (server-side only).
EXA_API_KEY=
TRAVELMIND_GROKSEARCH_PRIMARY_TIMEOUT_SECONDS=40
