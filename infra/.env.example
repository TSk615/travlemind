# Copy these keys into E:\travel\.env for direct API/worker runs if you need overrides.
# For Docker Compose, use this file directly with:
# docker compose --env-file infra/.env.example -f infra/docker-compose.yml up --build

# Host ports
WEB_PORT=3000
API_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432
XHS_CRAWLER_PORT=8090
GROKSEARCH_BRIDGE_PORT=8085

# Managed-service placeholders
POSTGRES_DB=travelmind
POSTGRES_USER=travelmind
POSTGRES_PASSWORD=travelmind

# App defaults for direct local runs
TRAVELMIND_DATABASE_URL=sqlite:///./storage/travelmind.db
TRAVELMIND_EXPORT_ROOT=./storage/exports
TRAVELMIND_JWT_SECRET=travelmind-dev-secret
TRAVELMIND_QUEUE_MODE=inline
TRAVELMIND_REDIS_URL=redis://127.0.0.1:6379/0
TRAVELMIND_AGENT_PROVIDER=stub
TRAVELMIND_PUBLIC_API_URL=http://localhost:8000
TRAVELMIND_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:3000","http://localhost:3000"]
TRAVELMIND_SEARCH_SERVICE_PROVIDER=exa
TRAVELMIND_SEARCH_SERVICE_TRANSPORT=mcp
TRAVELMIND_GROKSEARCH_BRIDGE_BASE_URL=http://groksearch-bridge:8085/mcp
TRAVELMIND_GROKSEARCH_BRIDGE_API_KEY=travelmind-groksearch-dev-key
TRAVELMIND_GROKSEARCH_BRIDGE_TIMEOUT_SECONDS=30

# Web build-time environment
VITE_API_BASE_URL=http://localhost:8000

# Set this to helloagents only for explicit PoC validation after the dependency is available.
# TRAVELMIND_AGENT_PROVIDER=helloagents

# Optional: switch backend search default from Exa to GrokSearch bridge
# TRAVELMIND_SEARCH_SERVICE_PROVIDER=groksearch
# TRAVELMIND_SEARCH_SERVICE_TRANSPORT=mcp

# Xiaohongshu crawler integration (internal / research only)
TRAVELMIND_XHS_CRAWLER_ENABLED=false
TRAVELMIND_XHS_CRAWLER_BASE_URL=http://xhs-crawler:8090
TRAVELMIND_XHS_CRAWLER_API_KEY=
TRAVELMIND_XHS_CRAWLER_TIMEOUT_SECONDS=20
TRAVELMIND_XHS_CACHE_TTL_SECONDS=1800
TRAVELMIND_XHS_LIMIT_PER_QUERY=5
TRAVELMIND_XHS_MAX_RESULTS=10
TRAVELMIND_XHS_SESSION_SECRET=
TRAVELMIND_XHS_NODE_BINARY=node
TRAVELMIND_XHS_OPENCLI_BINARY=opencli
TRAVELMIND_XHS_OPENCLI_TIMEOUT_SECONDS=45

# Build-time package mirrors
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_EXTRA_INDEX_URL=
PIP_DEFAULT_TIMEOUT=120

# GrokSearch bridge build and runtime settings
GROKSEARCH_GIT_URL=https://github.com/GuDaStudio/GrokSearch
GROKSEARCH_REF=grok-with-tavily
TRAVELMIND_GROKSEARCH_COMMAND=grok-search
GUDA_BASE_URL=https://code.guda.studio
GUDA_API_KEY=
GROK_API_URL=
GROK_API_KEY=
GROK_MODEL=grok-4.20-beta
TAVILY_ENABLED=true
TAVILY_API_URL=
TAVILY_API_KEY=
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=
GROK_DEBUG=false
GROK_LOG_LEVEL=INFO
