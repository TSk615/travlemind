FROM ghcr.io/astral-sh/uv:0.9.26 AS uv
FROM python:3.11-slim AS build
ARG GROKSEARCH_REF=8f0ae3c7f25ec419631ade7e431fa2531503433e
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_NO_PROGRESS=1
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/groksearch-bridge /app/apps/groksearch-bridge
RUN uv sync --project /app/apps/groksearch-bridge \
    && uv pip install --python /app/apps/groksearch-bridge/.venv/bin/python \
       "git+https://github.com/GuDaStudio/GrokSearch@${GROKSEARCH_REF}"

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH=/app/apps/groksearch-bridge/.venv/bin:$PATH \
    PYTHONPATH=/app/apps/groksearch-bridge/src \
    HOME=/app/storage
WORKDIR /app
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin travelmind
COPY --from=build /app /app
USER 10001:10001
CMD ["uvicorn", "travelmind_groksearch_bridge.main:app", "--host", "127.0.0.1", "--port", "18085"]
