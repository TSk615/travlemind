        }
      },
      "title": "LlmBookingInfo",
      "type": "object"
    },
    "LlmPlanDay": {
      "properties": {
        "flexible_windows": {
          "items": {
            "$ref": "#/$defs/FlexibleWindow"
          },
          "title": "Flexible Windows",
          "type": "array"
        },
        "title": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "total_cost": {
          "default": 0.0,
          "title": "Total Cost",
          "type": "number"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/LlmPlanItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "title",
        "items"
      ],
      "title": "LlmPlanDay",
      "type": "object"
    },
    "LlmPlanItem": {
      "properties": {
        "item_ref": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Ref"
        },
        "type": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "start_time": {
          "pattern": "^\\d{2}:\\d{2}$",
          "title": "Start Time",
          "type": "string"
        },
        "end_day_offset": {
          "default": 0,
          "maximum": 7,
          "minimum": 0,
          "title": "End Day Offset",
          "type": "integer"
        },
        "end_time": {
          "pattern": "^\\d{2}:\\d{2}$",
          "title": "End Time",
          "type": "string"
        },
        "location": {
          "default": "",
          "title": "Location",
          "type": "string"
        },
        "score": {
          "default": 0.8,
          "title": "Score",
          "type": "number"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "visit_intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisitIntent"
