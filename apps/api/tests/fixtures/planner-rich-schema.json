    "LodgingCostEstimate": {
      "description": "Agent-selected charge, independent of whether check-in is an activity.\n\nvalidation_status/validation_notes are replaced by the backend; model\nassertions of acceptance never constitute evidence.",
      "properties": {
        "cost_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cost Id",
          "type": "string"
        },
        "hotel_name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Hotel Name",
          "type": "string"
        },
        "source_url": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "rate_plan_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Plan Id"
        },
        "check_in": {
          "format": "date",
          "title": "Check In",
          "type": "string"
        },
        "check_out": {
          "format": "date",
          "title": "Check Out",
          "type": "string"
        },
        "room_count": {
          "maximum": 50,
          "minimum": 1,
          "title": "Room Count",
          "type": "integer"
        },
        "adults_per_room": {
          "maximum": 12,
          "minimum": 1,
          "title": "Adults Per Room",
          "type": "integer"
        },
        "children_ages": {
          "items": {
            "type": "integer"
          },
          "title": "Children Ages",
          "type": "array"
        },
        "nights": {
          "maximum": 366,
          "minimum": 1,
          "title": "Nights",
          "type": "integer"
        },
        "currency": {
          "default": "CNY",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "pricing_unit": {
          "enum": [
            "per_room_per_night",
            "per_stay"
          ],
          "title": "Pricing Unit",
          "type": "string"
        },
        "unit_price": {
          "exclusiveMinimum": 0,
          "title": "Unit Price",
          "type": "number"
        },
        "estimated_total": {
          "exclusiveMinimum": 0,
          "title": "Estimated Total",
          "type": "number"
        },
        "pricing_assumption": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Pricing Assumption",
          "type": "string"
        },
        "tax_status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "included",
            "excluded"
          ],
          "title": "Tax Status",
          "type": "string"
        },
        "validation_status": {
          "default": "pending",
          "enum": [
            "pending",
            "accepted",
            "rejected",
            "duplicate"
          ],
          "title": "Validation Status",
          "type": "string"
        },
        "validation_notes": {
          "items": {
            "type": "string"
          },
          "title": "Validation Notes",
          "type": "array"
        }
      },
      "required": [
        "cost_id",
        "hotel_name",
        "source_url",
        "check_in",
        "check_out",
        "room_count",
        "adults_per_room",
        "nights",
        "pricing_unit",
        "unit_price",
        "estimated_total",
        "pricing_assumption"
      ],
      "title": "LodgingCostEstimate",
      "type": "object"
    },
    "ScheduleIntent": {
