{
  "$defs": {
    "FlexibleWindow": {
      "description": "Intentional unfilled time, not a POI or a verified transit route.",
      "properties": {
        "start_time": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Start Time",
          "type": "string"
        },
        "end_time": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "End Time",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "free_time",
            "meal_break",
            "rest",
            "station_buffer",
            "contingency"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "note": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "start_time",
        "end_time",
        "purpose",
        "note"
      ],
      "title": "FlexibleWindow",
      "type": "object"
    },
    "LlmBookingInfo": {
